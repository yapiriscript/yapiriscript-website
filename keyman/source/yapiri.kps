<?xml version="1.0" encoding="utf-8"?>
<Package>

  <System>
    <KeymanDeveloperVersion>18.0.0.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>

  <Options>
    <ExecuteProgram></ExecuteProgram>
    <ReadMeFile>welcome.htm</ReadMeFile>
    <GraphicFile></GraphicFile>
    <MSIFileName></MSIFileName>
    <MSIOptions></MSIOptions>
    <FollowKeyboardVersion/>
  </Options>

  <StartMenu>
    <Folder>Yapiri Script</Folder>
    <AddUninstallEntry/>
    <Items>
      <Item>
        <Name>Welcome — Yapiri Script</Name>
        <FileName>welcome.htm</FileName>
        <Arguments></Arguments>
        <Icon></Icon>
        <Location>psmelStartMenu</Location>
      </Item>
    </Items>
  </StartMenu>

  <Info>
    <Name URL="">Yapiri</Name>
    <Version URL=""></Version>
    <Copyright URL="">© 2026 Animesh Debbarma</Copyright>
    <Author URL="mailto:yapiriscript@gmail.com">Animesh Debbarma</Author>
    <WebSite URL="https://yapiriscript.com">https://yapiriscript.com</WebSite>
    <Description URL="">Type in Yapiri Script — a modern phonemic alphabet for the Kokborok
language, spoken by over a million Tiprasa people across Tripura, India.

Each key maps to a phoneme of Kokborok following a phoneme-organised layout.
The keyboard covers the complete Yapiri character inventory: 25 consonants,
6 vowels, 10 numerals, 5 punctuation marks, 2 combining diacritics (high tone
mark and reduplication mark), and the standard hyphen — 49 characters in total.

Aspirated consonants (ph, th, kh, chh) and the palatal n-prime are accessed
via SHIFT on desktop, or via long-press on mobile.

The Yapiri font is bundled with this package and installed automatically.

Yapiri — footprints in Kokborok — is a living script born from within the
Tiprasa community, created to give Kokborok a writing system truly shaped
by its own phonology.

Visit https://yapiriscript.com for guides, charts, and community resources.</Description>
  </Info>

  <Files>

    <!-- Welcome page (shown before install) -->
    <File>
      <Name>welcome.htm</Name>
      <Description>Welcome — Yapiri Script Keyboard</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.htm</FileType>
    </File>

    <!-- Compiled keyboard — desktop (Windows / macOS / Linux) -->
    <File>
      <Name>..\build\yapiri.kmx</Name>
      <Description>Yapiri Script Keyboard</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>

    <!-- Compiled keyboard — web / KeymanWeb -->
    <File>
      <Name>..\build\yapiri.js</Name>
      <Description>Yapiri Script Keyboard (Web)</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>

    <!-- Touch layout — mobile keyboard -->
    <File>
      <Name>yapiri.keyman-touch-layout</Name>
      <Description>Yapiri Touch Keyboard Layout</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.keyman-touch-layout</FileType>
    </File>

    <!-- Yapiri font — required for glyph rendering -->
    <File>
      <Name>Yapiri.ttf</Name>
      <Description>Yapiri Script Font</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.ttf</FileType>
    </File>

  </Files>

  <Keyboards>
    <Keyboard>
      <ID>yapiri</ID>
      <DisplayFont>Yapiri.ttf</DisplayFont>
      <Languages>
        <Language ID="trp">Kokborok</Language>
      </Languages>
      <Examples>
        <Example ID="trp"
          Keys="n a m s K_SPACE y a p i r i"
          Text="&#xE013;&#xE000;&#xE012;&#xE016; &#xE01C;&#xE000;&#xE006;&#xE002;&#xE017;&#xE002;"
          Note="nams yapiri — my footprints"/>
      </Examples>
    </Keyboard>
  </Keyboards>

</Package>
