c Yapiri Script Keyboard
c Author: Animesh Debbarma
c Version: 1.0.0
c Language: trp-IN (Kokborok, Tripura, India)
c Website: https://yapiriscript.com
c Copyright: 2026 Animesh Debbarma

store(&VERSION) '10.0'
store(&NAME) 'Yapiri'
store(&COPYRIGHT) '© 2026 Animesh Debbarma'
store(&KEYBOARDVERSION) '1.0.0'
store(&TARGETS) 'any'
store(&VISUALKEYBOARD) 'yapiri.kvks'
store(&LAYOUTFILE) 'yapiri.keyman-touch-layout'

begin Unicode > use(main)

store(yapiri_base) U+E000 U+E001 U+E002 U+E003 U+E004 U+E005 U+E006 U+E007 U+E008 U+E009 U+E00A U+E00B U+E00C U+E00D U+E00E U+E00F U+E010 U+E011 U+E012 U+E013 U+E014 U+E015 U+E016 U+E017 U+E018 U+E019 U+E01A U+E01B U+E01C U+E01D U+E01E U+E01F U+E020 U+E021 U+E022 U+E023 U+E024 U+E025 U+E026 U+E027 U+E028 U+E029 U+E02A U+E02B U+E02C U+E02D

store(yapiri_diacritic) U+0301 U+030B

group(main) using keys

c Backspace
any(yapiri_base) U+0301 + [K_BKSP] > context(1)
any(yapiri_base) U+030B + [K_BKSP] > context(1)

c Vowels
+ [K_A] > U+E000
+ [K_E] > U+E001
+ [K_I] > U+E002
+ [K_U] > U+E003
+ [K_O] > U+E004
+ [K_Q] > U+E005

c Consonants plain
+ [K_P] > U+E006
+ [K_T] > U+E007
+ [K_K] > U+E008
+ [K_B] > U+E00C
+ [K_D] > U+E00D
+ [K_G] > U+E00E
+ [K_C] > U+E00F
+ [K_J] > U+E010
+ [K_M] > U+E012
+ [K_N] > U+E013
+ [K_X] > U+E015
+ [K_S] > U+E016
+ [K_R] > U+E017
+ [K_L] > U+E018
+ [K_V] > U+E019
+ [K_F] > U+E01A
+ [K_Z] > U+E01B
+ [K_Y] > U+E01C
+ [K_W] > U+E01D
+ [K_H] > U+E01E

c Consonants aspirated desktop
+ [SHIFT K_P] > U+E009
+ [SHIFT K_T] > U+E00A
+ [SHIFT K_K] > U+E00B
+ [SHIFT K_C] > U+E011
+ [SHIFT K_N] > U+E014

c Consonants aspirated touch
+ [T_PH]  > U+E009
+ [T_TH]  > U+E00A
+ [T_KH]  > U+E00B
+ [T_CHH] > U+E011
+ [T_NP]  > U+E014

c Punctuation touch
+ [T_EXCL] > U+E02B
+ [T_QUOT] > U+E02C
+ [T_QUES] > U+E02D

c Numerals
+ [K_0] > U+E01F
+ [K_1] > U+E020
+ [K_2] > U+E021
+ [K_3] > U+E022
+ [K_4] > U+E023
+ [K_5] > U+E024
+ [K_6] > U+E025
+ [K_7] > U+E026
+ [K_8] > U+E027
+ [K_9] > U+E028

c Punctuation
+ [K_COMMA] > U+E029
+ [K_PERIOD] > U+E02A
+ [SHIFT K_1] > U+E02B
+ [SHIFT K_QUOTE] > U+E02C
+ [SHIFT K_SLASH] > U+E02D
+ [K_HYPHEN] > U+002D

c Diacritics
+ [K_QUOTE] > U+0301
+ [K_BKQUOTE] > U+030B

c Space
+ [K_SPACE] > ' '
